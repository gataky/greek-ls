# Loaded by direnv on cd. After editing this file, run `direnv allow` once.
# Go itself comes from the asdf shim, which reads .tool-versions.

# `make build` puts greek-ls here
PATH_add bin

# Default dictionary for `greek-ls` run by hand; Neovim passes its own path
export GREEK_LS_DB="$PWD/lemma_greek_en.db"
